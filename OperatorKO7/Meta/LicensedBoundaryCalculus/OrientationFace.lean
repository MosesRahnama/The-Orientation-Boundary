import OperatorKO7.Meta.LicensedBoundaryCalculus.LicensedReductionMorphism
import OperatorKO7.Meta.RDRSProjectionTransaction

/-!
# Orientation face as a licensed reduction morphism

The orientation face reads a static `ProjectionTransaction` as a licensed
state-map morphism.  The source relation is the root RDRS step-pair relation;
the target relation is the projected RDRS step-pair relation; the map is the
transaction projection `pi`.

## Audit slots

Relation: source and projected `RDRSStep` root relations.
Closure: one-step simulation plus finite-path transport inherited from
`LicensedReductionMorphism`.
Trust: kernel-only; fixtures use finite Bool/Unit carriers.
Scope: static projection transactions over root one-step relations.
-/

set_option autoImplicit false

namespace OperatorKO7.Meta.LicensedBoundaryCalculus

open OperatorKO7.RDRSDescentLens
open OperatorKO7.RDRSSeedCollapse
open OperatorKO7.RDRSProjectionTransaction

/-- Root relation generated by an abstract RDRS step-pair. -/
def rdrsRootRelation {B S N T : Type}
    (R : RDRSStep B S N T) (x y : T) : Prop :=
  exists b s n, x = R.lhs b s n /\ y = R.rhs b s n

/-- Source ARS for a raw RDRS step-pair. -/
def rdrsSourceARS {B S N T : Type}
    (R : RDRSStep B S N T) : ARS where
  Carrier := T
  step := rdrsRootRelation R
  scope :=
    { location := .root
      closure := .oneStep
      admission := .full
      layer := .original }

/-- Target ARS for a projected RDRS step-pair. -/
def rdrsProjectedARS {B S N T' : Type}
    (R : RDRSStep B S N T') : ARS where
  Carrier := T'
  step := rdrsRootRelation R
  scope :=
    { location := .root
      closure := .oneStep
      admission := .full
      layer := .projected }

/-- Orientation-face carrier for the static projection transaction. -/
structure OrientationFace {B S N T : Type}
    (R : RDRSStep B S N T) where
  transaction : ProjectionTransaction R

namespace OrientationFace

variable {B S N T : Type}
variable {R : RDRSStep B S N T}

/-- The projection transaction induces a licensed reduction morphism whose
admitted relation is the full source root relation. -/
def toMorphism (F : OrientationFace R) :
    LicensedReductionMorphism (rdrsSourceARS R)
      (rdrsProjectedARS F.transaction.Rproj) where
  admitted := (rdrsSourceARS R).step
  admitted_sub_raw := fun h => h
  map := F.transaction.pi
  map_step := by
    intro x y hxy
    unfold rdrsSourceARS rdrsRootRelation at hxy
    rcases hxy with ⟨b, s, n, hx, hy⟩
    refine ⟨b, s, n, ?_, ?_⟩
    · rw [hx, F.transaction.pi_commutes_lhs]
    · rw [hy, F.transaction.pi_commutes_rhs]

/-- The orientation morphism admits every raw RDRS root edge. -/
theorem toMorphism_admits_all (F : OrientationFace R)
    {x y : T} (h : (rdrsSourceARS R).step x y) :
    (F.toMorphism).admitted x y := h

/-! ## Finite collapse fixture -/

/-- Bool source step used to witness genuine projection collapse. -/
def boolStep_fixture : RDRSStep Unit Unit Unit Bool where
  lhs _ _ _ := false
  rhs _ _ _ := true

/-- Unit projected step for the collapsed Bool fixture. -/
def unitStep_fixture : RDRSStep Unit Unit Unit Unit where
  lhs _ _ _ := ()
  rhs _ _ _ := ()

/-- Seed collapse for the Bool-to-Unit projection fixture. -/
def boolSeedCollapse_fixture : SeedCollapse Unit Bool where
  carrier _ := false
  collapse _ := ()
  collapse_carrier := by intro u; cases u; rfl

/-- The Bool projection transaction collapses `false` and `true` to one point. -/
def boolOrientationFace_fixture : OrientationFace boolStep_fixture where
  transaction :=
    { T' := Unit
      pi := fun _ => ()
      Rproj := unitStep_fixture
      pi_commutes_lhs := by intro _ _ _; rfl
      pi_commutes_rhs := by intro _ _ _; rfl
      A' := Unit
      mu' := fun _ => ()
      ltA' := fun _ _ => False
      PayloadCarrier := Unit
      seedCollapse := boolSeedCollapse_fixture
      pi_factors_seedCollapse :=
        { factor := fun _ => ()
          obs_eq := by intro _; rfl }
      CounterIndex := Unit
      counterFactor := fun _ => ()
      retainedCoordinate := fun _ => ()
      mu'_factors_counter := by intro t; cases t; rfl }

/-- The fixture projection collapses two distinct source states. -/
theorem boolOrientationFace_collapses_states :
    exists x y : Bool,
      Not (x = y) /\
        (boolOrientationFace_fixture.toMorphism).map x =
          (boolOrientationFace_fixture.toMorphism).map y := by
  exact ⟨false, true, by decide, rfl⟩

#check rdrsRootRelation
#check rdrsSourceARS
#check rdrsProjectedARS
#check OrientationFace.toMorphism
#check OrientationFace.toMorphism_admits_all
#check boolOrientationFace_collapses_states
#print axioms OrientationFace.toMorphism_admits_all
#print axioms boolOrientationFace_collapses_states

end OrientationFace

end OperatorKO7.Meta.LicensedBoundaryCalculus
