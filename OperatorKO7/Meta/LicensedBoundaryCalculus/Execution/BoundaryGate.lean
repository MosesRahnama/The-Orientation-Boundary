import OperatorKO7.Meta.LicensedBoundaryCalculus.Accounting.EventTrace
import OperatorKO7.Meta.LicensedBoundaryCalculus.Core.PartialComposition

/-!
# Executable licensed-boundary gate

The gate consumes proofs deciding endpoint-domain membership and edge
admission.  It returns a dependent certificate whose constructor fixes the
decision and the only permitted output.  The execution trace is generated by
the decision, never supplied by a caller.

## Audit slots

Relation: one proposed raw edge and the morphism's admitted subrelation.
Closure: one gate decision; no reachability strengthening.
Trust: kernel-only proposition evidence and dependent certificates.
Scope: one finite or infinite boundary edge execution.
-/

set_option autoImplicit false

namespace OperatorKO7.Meta.LicensedBoundaryCalculus

universe u v

/-- Proof-relevant evidence deciding one proposition. -/
inductive PropositionEvidence (P : Prop) : Type
  | proved (proof : P)
  | refuted (proof : ¬ P)

/-- The three mutually exclusive gate outcomes. -/
inductive BoundaryDecision
  | refuseState
  | refuseEdge
  | commit
  deriving DecidableEq, Repr

/-- A raw edge together with complete endpoint-domain and admission evidence. -/
structure BoundaryExecutionInput {A : ARS.{u}} {B : ARS.{v}}
    (F : PartialLicensedReductionMorphism A B) where
  source : A.Carrier
  proposedTarget : A.Carrier
  rawEdge : A.step source proposedTarget
  stateEvidence :
    PropositionEvidence (F.domain source ∧ F.domain proposedTarget)
  edgeEvidence : PropositionEvidence (F.admitted source proposedTarget)

namespace BoundaryExecutionInput

/-- Construct complete execution evidence from a raw edge. -/
noncomputable def inspect {A : ARS.{u}} {B : ARS.{v}}
    (F : PartialLicensedReductionMorphism A B)
    {source target : A.Carrier} (rawEdge : A.step source target) :
    BoundaryExecutionInput F := by
  classical
  refine
    { source := source
      proposedTarget := target
      rawEdge := rawEdge
      stateEvidence := ?_
      edgeEvidence := ?_ }
  · by_cases h : F.domain source ∧ F.domain target
    · exact .proved h
    · exact .refuted h
  · by_cases h : F.admitted source target
    · exact .proved h
    · exact .refuted h

end BoundaryExecutionInput

/-- The canonical event trace generated by each decision. -/
def decisionTrace : BoundaryDecision → EventTrace
  | .refuseState => [⟨.domainCheck⟩, ⟨.stateRefusal⟩]
  | .refuseEdge =>
      [⟨.domainCheck⟩, ⟨.domainCheck⟩,
        ⟨.edgeCheck⟩, ⟨.edgeRefusal⟩]
  | .commit =>
      [⟨.domainCheck⟩, ⟨.domainCheck⟩,
        ⟨.edgeCheck⟩, ⟨.replayStep⟩]

/-- A decision certificate fixes both the outcome and its output. -/
inductive DecisionCertificate
    {A : ARS.{u}} {B : ARS.{v}}
    (F : PartialLicensedReductionMorphism A B)
    (input : BoundaryExecutionInput F) :
    BoundaryDecision → Option B.Carrier → Type
  | stateRefusal
      (outside : ¬ (F.domain input.source ∧
        F.domain input.proposedTarget)) :
      DecisionCertificate F input .refuseState none
  | edgeRefusal
      (inside : F.domain input.source ∧ F.domain input.proposedTarget)
      (rejected : ¬ F.admitted input.source input.proposedTarget) :
      DecisionCertificate F input .refuseEdge none
  | commit
      (admitted : F.admitted input.source input.proposedTarget) :
      DecisionCertificate F input .commit
        (some (F.map
          ⟨input.proposedTarget, F.admitted_target_domain admitted⟩))

/-- Result carrier.  Arbitrary results can be modeled for negative tests, but
only `execute` is the production constructor. -/
structure BoundaryExecutionResult
    {A : ARS.{u}} {B : ARS.{v}}
    (F : PartialLicensedReductionMorphism A B)
    (input : BoundaryExecutionInput F) where
  decision : BoundaryDecision
  trace : EventTrace
  output? : Option B.Carrier
  certificate : DecisionCertificate F input decision output?

/-- Execute the boundary decision from the supplied proof evidence. -/
def execute {A : ARS.{u}} {B : ARS.{v}}
    (F : PartialLicensedReductionMorphism A B)
    (input : BoundaryExecutionInput F) :
    BoundaryExecutionResult F input :=
  match input.stateEvidence with
  | .refuted outside =>
      { decision := .refuseState
        trace := decisionTrace .refuseState
        output? := none
        certificate := .stateRefusal outside }
  | .proved inside =>
      match input.edgeEvidence with
      | .refuted rejected =>
          { decision := .refuseEdge
            trace := decisionTrace .refuseEdge
            output? := none
            certificate := .edgeRefusal inside rejected }
      | .proved admitted =>
          { decision := .commit
            trace := decisionTrace .commit
            output? := some (F.map
              ⟨input.proposedTarget,
                F.admitted_target_domain admitted⟩)
            certificate := .commit admitted }

/-- Commit occurs exactly for an in-domain admitted raw edge. -/
theorem execute_commit_iff_domain_and_admitted
    {A : ARS.{u}} {B : ARS.{v}}
    (F : PartialLicensedReductionMorphism A B)
    (input : BoundaryExecutionInput F) :
    (execute F input).decision = .commit ↔
      F.domain input.source ∧ F.domain input.proposedTarget ∧
        F.admitted input.source input.proposedTarget := by
  rcases input with ⟨source, target, raw, stateEvidence, edgeEvidence⟩
  cases stateEvidence with
  | proved inside =>
      cases edgeEvidence with
      | proved admitted => simp [execute, inside, admitted]
      | refuted rejected => simp [execute, inside, rejected]
  | refuted outside =>
      cases edgeEvidence with
      | refuted rejected =>
          simp only [execute, reduceCtorEq, false_iff]
          rintro ⟨hsource, htarget, _⟩
          exact outside ⟨hsource, htarget⟩
      | proved admitted =>
          exact False.elim
            (outside
              ⟨F.admitted_source_domain admitted,
                F.admitted_target_domain admitted⟩)

/-- A generated state refusal certifies that at least one endpoint is outside
the morphism domain. -/
theorem execute_state_refusal_sound
    {A : ARS.{u}} {B : ARS.{v}}
    (F : PartialLicensedReductionMorphism A B)
    (input : BoundaryExecutionInput F)
    (hdecision : (execute F input).decision = .refuseState) :
    ¬ F.domain input.source ∨ ¬ F.domain input.proposedTarget := by
  rcases input with ⟨source, target, raw, stateEvidence, edgeEvidence⟩
  cases stateEvidence with
  | proved inside =>
      cases edgeEvidence <;> simp [execute] at hdecision
  | refuted outside =>
      tauto

/-- A generated edge refusal certifies in-domain endpoints and failed edge
admission. -/
theorem execute_edge_refusal_sound
    {A : ARS.{u}} {B : ARS.{v}}
    (F : PartialLicensedReductionMorphism A B)
    (input : BoundaryExecutionInput F)
    (hdecision : (execute F input).decision = .refuseEdge) :
    F.domain input.source ∧ F.domain input.proposedTarget ∧
      ¬ F.admitted input.source input.proposedTarget := by
  rcases input with ⟨source, target, raw, stateEvidence, edgeEvidence⟩
  cases stateEvidence with
  | refuted outside => simp [execute] at hdecision
  | proved inside =>
      cases edgeEvidence with
      | proved admitted => simp [execute] at hdecision
      | refuted rejected => exact ⟨inside.1, inside.2, rejected⟩

/-- On every admitted input, the generated output is the morphism image of
the proposed target. -/
theorem execute_commit_output_eq_map
    {A : ARS.{u}} {B : ARS.{v}}
    (F : PartialLicensedReductionMorphism A B)
    (input : BoundaryExecutionInput F)
    (admitted : F.admitted input.source input.proposedTarget) :
    (execute F input).output? =
      some (F.map
        ⟨input.proposedTarget, F.admitted_target_domain admitted⟩) := by
  rcases input with ⟨source, target, raw, stateEvidence, edgeEvidence⟩
  cases stateEvidence with
  | refuted outside =>
      exact False.elim
        (outside
          ⟨F.admitted_source_domain admitted,
            F.admitted_target_domain admitted⟩)
  | proved inside =>
      cases edgeEvidence with
      | refuted rejected => exact False.elim (rejected admitted)
      | proved evidence => simp [execute]

/-- The production trace is definitionally the trace assigned to its
decision. -/
theorem execute_trace_eq
    {A : ARS.{u}} {B : ARS.{v}}
    (F : PartialLicensedReductionMorphism A B)
    (input : BoundaryExecutionInput F) :
    (execute F input).trace = decisionTrace (execute F input).decision := by
  rcases input with ⟨source, target, raw, stateEvidence, edgeEvidence⟩
  cases stateEvidence <;> cases edgeEvidence <;> simp [execute]

/-! ## Non-vacuity fixtures -/

open PartialLicensedReductionMorphism

/-- One raw chain edge whose target is outside the partial domain. -/
def stateRefusalInput_fixture :
    BoundaryExecutionInput partialChain_fixture where
  source := ChainNode.source
  proposedTarget := ChainNode.target
  rawEdge := ChainStep.descend
  stateEvidence := .refuted (by
    rintro ⟨_, htarget⟩
    exact partialChain_fixture_undefined_target htarget)
  edgeEvidence := .refuted (by intro h; exact h)

/-- One in-domain chain edge rejected by a pure edge license. -/
def edgeRefusalInput_fixture :
    BoundaryExecutionInput pureEdgeRejection_fixture where
  source := ChainNode.source
  proposedTarget := ChainNode.target
  rawEdge := ChainStep.descend
  stateEvidence := .proved ⟨trivial, trivial⟩
  edgeEvidence := .refuted (by intro h; exact h)

/-- One admitted identity edge. -/
def commitInput_fixture :
    BoundaryExecutionInput
      (PartialLicensedReductionMorphism.id chainARS_fixture) where
  source := ChainNode.source
  proposedTarget := ChainNode.target
  rawEdge := ChainStep.descend
  stateEvidence := .proved ⟨trivial, trivial⟩
  edgeEvidence := .proved ChainStep.descend

theorem three_decisions_nonvacuous_fixture :
    (execute partialChain_fixture stateRefusalInput_fixture).decision =
        .refuseState ∧
      (execute pureEdgeRejection_fixture edgeRefusalInput_fixture).decision =
        .refuseEdge ∧
      (execute (PartialLicensedReductionMorphism.id chainARS_fixture)
        commitInput_fixture).decision = .commit := by
  exact ⟨rfl, rfl, rfl⟩

#check @execute_commit_iff_domain_and_admitted
#check @execute_state_refusal_sound
#check @execute_edge_refusal_sound
#check @execute_commit_output_eq_map
#check @execute_trace_eq
#check three_decisions_nonvacuous_fixture
#print axioms execute_commit_iff_domain_and_admitted
#print axioms execute_state_refusal_sound
#print axioms execute_edge_refusal_sound
#print axioms execute_commit_output_eq_map
#print axioms execute_trace_eq
