import Mathlib.Tactic

/-!
# Theory XII: Grammar-closure direct-measure barrier

Boundary-general cross-paper packet, Theory XII. The Orientation Boundary paper rules out the
duplicating step for a long enumerated list of named direct-measure classes (additive, affine,
quadratic, multilinear, polynomial, max-plus, matrix, ...). This module replaces the *list* by a
single **closed reflected grammar** of direct whole-term measures over the canonical
`(counter, payload)` carrier, generated by the counter and payload coordinates, constants, sums,
products, pointwise maxima, and scalar multiples (the "polynomial-plus-max umbrella"), and proves
the barrier by **structural induction over the grammar**:

* `eval_payloadMonotone`: every grammar measure is monotone-nondecreasing in the payload coordinate
  (the duplicated payload can only add mass).
* `barrier`: any payload-monotone measure whose payload dependence is unbounded cannot strictly
  orient the duplicating step, because the duplicated payload is *pumpable*: a single finite
  left-hand-side value cannot dominate an unbounded family of right-hand-side values.
* `grammar_measure_blocked`: hence every grammar measure with unbounded payload dependence is
  blocked. `payload_blocked` is the canonical instance.
* `payloadEffective_measures_blocked`: a syntactic, nondegenerate effective-payload certificate
  discharges the unboundedness hypothesis automatically. This is deliberately stronger than
  "the payload symbol occurs": zeroed terms such as `0 * payload` are excluded.
* `counter_orients`: the payload-blind counter projection *does* orient the step. This is the escape
  side of the boundary (the dependency-pair / counter-projection route).

Together these give a grammar-level orientation boundary: orientation requires payload-blindness,
and every measure that genuinely reads the duplicated payload is blocked. The counter projection
provides an orienting payload-blind witness. The theorem applies to each named measure family that
is represented by this grammar.
-/

set_option autoImplicit false

namespace OperatorKO7.Meta.BoundaryGeneral.DirectMeasureGrammarClosure

/-! ### Reflected direct-measure grammar over the `(counter, payload)` carrier -/

/-- A reflected direct whole-term measure expression over the canonical two-coordinate carrier
`(counter, payload)`. The constructors are the base coordinates, constants, and the closed algebra
of sums, products, pointwise maxima, and natural scalar multiples. -/
inductive MeasureExpr where
  | counter
  | payload
  | const (n : Nat)
  | add (e f : MeasureExpr)
  | mul (e f : MeasureExpr)
  | max (e f : MeasureExpr)
  | smul (n : Nat) (e : MeasureExpr)

/-- Denotation of a grammar expression as a direct measure `(counter)(payload) → ℕ`. -/
def MeasureExpr.eval : MeasureExpr → Nat → Nat → Nat
  | counter,  c, _ => c
  | payload,  _, p => p
  | const n,  _, _ => n
  | add e f,  c, p => e.eval c p + f.eval c p
  | mul e f,  c, p => e.eval c p * f.eval c p
  | max e f,  c, p => Nat.max (e.eval c p) (f.eval c p)
  | smul n e, c, p => n * e.eval c p

/-! ### Carrier invariants -/

/-- A measure is payload-monotone when it is nondecreasing in the payload coordinate (with the
counter held fixed): adding payload mass never decreases the measure. -/
def PayloadMonotone (m : Nat → Nat → Nat) : Prop :=
  ∀ c p p', p ≤ p' → m c p ≤ m c p'

/-- A measure has unbounded payload dependence when, at a fixed counter, its value can be driven
above any bound by growing the payload (with a strictly positive payload increment). This is the
pump: the duplicated payload can be made arbitrarily heavy. -/
def PayloadUnbounded (m : Nat → Nat → Nat) : Prop :=
  ∀ c p N, ∃ L, 1 ≤ L ∧ N ≤ m c (p + L)

/-- A measure orients the duplicating step uniformly when, across every duplicating rewrite (the
counter drops by one while a payload copy of any positive size `L` is added), the measure strictly
decreases: `m (c+1) p > m c (p + L)`. -/
def OrientsDupStep (m : Nat → Nat → Nat) : Prop :=
  ∀ c p L, 1 ≤ L → m c (p + L) < m (c + 1) p

/-! ### Syntactic effective-payload certificates -/

/-- A syntactic certificate that an expression is always at least one. This is the positive
cofactor condition needed for multiplication: multiplying an unbounded payload-dependent expression
by a uniformly positive expression preserves unboundedness, while multiplying by zero does not. -/
inductive PayloadPositiveFloor : MeasureExpr → Prop where
  | const_pos {n : Nat} (hn : 0 < n) :
      PayloadPositiveFloor (MeasureExpr.const n)
  | add_left {e f : MeasureExpr} (h : PayloadPositiveFloor e) :
      PayloadPositiveFloor (MeasureExpr.add e f)
  | add_right {e f : MeasureExpr} (h : PayloadPositiveFloor f) :
      PayloadPositiveFloor (MeasureExpr.add e f)
  | mul {e f : MeasureExpr}
      (he : PayloadPositiveFloor e) (hf : PayloadPositiveFloor f) :
      PayloadPositiveFloor (MeasureExpr.mul e f)
  | max_left {e f : MeasureExpr} (h : PayloadPositiveFloor e) :
      PayloadPositiveFloor (MeasureExpr.max e f)
  | max_right {e f : MeasureExpr} (h : PayloadPositiveFloor f) :
      PayloadPositiveFloor (MeasureExpr.max e f)
  | smul_pos {n : Nat} {e : MeasureExpr}
      (hn : 0 < n) (h : PayloadPositiveFloor e) :
      PayloadPositiveFloor (MeasureExpr.smul n e)

/-- A syntactic certificate that payload dependence is effective, not merely present in the source
tree. It excludes erased payload occurrences such as `smul 0 payload` and `payload * const 0`, but
keeps the closed algebraic constructors that genuinely preserve an unbounded payload pump. -/
inductive PayloadEffective : MeasureExpr → Prop where
  | payload : PayloadEffective MeasureExpr.payload
  | add_left {e f : MeasureExpr} (h : PayloadEffective e) :
      PayloadEffective (MeasureExpr.add e f)
  | add_right {e f : MeasureExpr} (h : PayloadEffective f) :
      PayloadEffective (MeasureExpr.add e f)
  | max_left {e f : MeasureExpr} (h : PayloadEffective e) :
      PayloadEffective (MeasureExpr.max e f)
  | max_right {e f : MeasureExpr} (h : PayloadEffective f) :
      PayloadEffective (MeasureExpr.max e f)
  | smul_pos {n : Nat} {e : MeasureExpr}
      (hn : 0 < n) (h : PayloadEffective e) :
      PayloadEffective (MeasureExpr.smul n e)
  | mul_left_floor {e f : MeasureExpr}
      (he : PayloadEffective e) (hf : PayloadPositiveFloor f) :
      PayloadEffective (MeasureExpr.mul e f)
  | mul_right_floor {e f : MeasureExpr}
      (he : PayloadPositiveFloor e) (hf : PayloadEffective f) :
      PayloadEffective (MeasureExpr.mul e f)
  | mul_both {e f : MeasureExpr}
      (he : PayloadEffective e) (hf : PayloadEffective f) :
      PayloadEffective (MeasureExpr.mul e f)

/-- Executable positive-floor checker for the reflected grammar. -/
def MeasureExpr.positiveFloor? : MeasureExpr → Bool
  | counter => false
  | payload => false
  | const n => decide (0 < n)
  | add e f => e.positiveFloor? || f.positiveFloor?
  | mul e f => e.positiveFloor? && f.positiveFloor?
  | max e f => e.positiveFloor? || f.positiveFloor?
  | smul n e => decide (0 < n) && e.positiveFloor?

/-- Executable effective-payload checker for the reflected grammar. -/
def MeasureExpr.payloadEffective? : MeasureExpr → Bool
  | counter => false
  | payload => true
  | const _ => false
  | add e f => e.payloadEffective? || f.payloadEffective?
  | mul e f =>
      (e.payloadEffective? && f.positiveFloor?) ||
        (e.positiveFloor? && f.payloadEffective?) ||
          (e.payloadEffective? && f.payloadEffective?)
  | max e f => e.payloadEffective? || f.payloadEffective?
  | smul n e => decide (0 < n) && e.payloadEffective?

/-! ### Grammar closure: every grammar measure is payload-monotone -/

/-- **Grammar-closure monotonicity.** Every reflected grammar measure is payload-monotone. Proved
by structural induction; each constructor (sum, product, maximum, scalar multiple) preserves
monotonicity, so the whole infinite family of generated measures is covered by one finite
induction. -/
theorem eval_payloadMonotone (e : MeasureExpr) : PayloadMonotone e.eval := by
  induction e with
  | counter => intro c p p' _; exact Nat.le_refl c
  | payload => intro c p p' h; exact h
  | const n => intro c p p' _; exact Nat.le_refl n
  | add e f ihe ihf =>
      intro c p p' h; exact Nat.add_le_add (ihe c p p' h) (ihf c p p' h)
  | mul e f ihe ihf =>
      intro c p p' h; exact Nat.mul_le_mul (ihe c p p' h) (ihf c p p' h)
  | max e f ihe ihf =>
      intro c p p' h; exact max_le_max (ihe c p p' h) (ihf c p p' h)
  | smul n e ihe =>
      intro c p p' h; exact Nat.mul_le_mul (Nat.le_refl n) (ihe c p p' h)

theorem payloadPositiveFloor_eval_ge_one {e : MeasureExpr}
    (h : PayloadPositiveFloor e) :
    ∀ c p, 1 ≤ e.eval c p := by
  induction h with
  | const_pos hn =>
      intro c p
      simp [MeasureExpr.eval]
      omega
  | add_left h ih =>
      rename_i e f
      intro c p
      have hpos := ih c p
      simp [MeasureExpr.eval]
      omega
  | add_right h ih =>
      rename_i e f
      intro c p
      have hpos := ih c p
      simp [MeasureExpr.eval]
      omega
  | mul he hf ihe ihf =>
      rename_i e f
      intro c p
      have hmul := Nat.mul_le_mul (ihe c p) (ihf c p)
      simpa [MeasureExpr.eval] using hmul
  | max_left h ih =>
      rename_i e f
      intro c p
      exact le_trans (ih c p)
        (by simp [MeasureExpr.eval])
  | max_right h ih =>
      rename_i e f
      intro c p
      exact le_trans (ih c p)
        (by simp [MeasureExpr.eval])
  | smul_pos hn h ih =>
      rename_i n e
      intro c p
      have hn1 : 1 ≤ n := Nat.succ_le_of_lt hn
      have hmul := Nat.mul_le_mul hn1 (ih c p)
      simpa [MeasureExpr.eval] using hmul

theorem positiveFloor?_sound (e : MeasureExpr) :
    e.positiveFloor? = true → PayloadPositiveFloor e := by
  induction e with
  | counter =>
      simp [MeasureExpr.positiveFloor?]
  | payload =>
      simp [MeasureExpr.positiveFloor?]
  | const n =>
      simp [MeasureExpr.positiveFloor?]
      intro hn
      exact PayloadPositiveFloor.const_pos hn
  | add e f ihe ihf =>
      simp [MeasureExpr.positiveFloor?]
      intro h
      cases h with
      | inl he => exact PayloadPositiveFloor.add_left (ihe he)
      | inr hf => exact PayloadPositiveFloor.add_right (ihf hf)
  | mul e f ihe ihf =>
      simp [MeasureExpr.positiveFloor?]
      intro he hf
      exact PayloadPositiveFloor.mul (ihe he) (ihf hf)
  | max e f ihe ihf =>
      simp [MeasureExpr.positiveFloor?]
      intro h
      cases h with
      | inl he => exact PayloadPositiveFloor.max_left (ihe he)
      | inr hf => exact PayloadPositiveFloor.max_right (ihf hf)
  | smul n e ihe =>
      simp [MeasureExpr.positiveFloor?]
      intro hn he
      exact PayloadPositiveFloor.smul_pos hn (ihe he)

theorem positiveFloor?_complete {e : MeasureExpr}
    (h : PayloadPositiveFloor e) :
    e.positiveFloor? = true := by
  induction h with
  | const_pos hn =>
      simp [MeasureExpr.positiveFloor?, hn]
  | add_left h ih =>
      simp [MeasureExpr.positiveFloor?, ih]
  | add_right h ih =>
      simp [MeasureExpr.positiveFloor?, ih]
  | mul he hf ihe ihf =>
      simp [MeasureExpr.positiveFloor?, ihe, ihf]
  | max_left h ih =>
      simp [MeasureExpr.positiveFloor?, ih]
  | max_right h ih =>
      simp [MeasureExpr.positiveFloor?, ih]
  | smul_pos hn h ih =>
      simp [MeasureExpr.positiveFloor?, hn, ih]

theorem payloadEffective?_sound (e : MeasureExpr) :
    e.payloadEffective? = true → PayloadEffective e := by
  induction e with
  | counter =>
      simp [MeasureExpr.payloadEffective?]
  | payload =>
      intro _
      exact PayloadEffective.payload
  | const n =>
      simp [MeasureExpr.payloadEffective?]
  | add e f ihe ihf =>
      simp [MeasureExpr.payloadEffective?]
      intro h
      cases h with
      | inl he => exact PayloadEffective.add_left (ihe he)
      | inr hf => exact PayloadEffective.add_right (ihf hf)
  | mul e f ihe ihf =>
      intro h
      cases heff : e.payloadEffective? <;>
      cases hff : f.payloadEffective? <;>
      cases hpe : e.positiveFloor? <;>
      cases hpf : f.positiveFloor? <;>
      simp [MeasureExpr.payloadEffective?, heff, hff, hpe, hpf] at h
      all_goals
        first
        | exact PayloadEffective.mul_left_floor
            (ihe heff) (positiveFloor?_sound f hpf)
        | exact PayloadEffective.mul_right_floor
            (positiveFloor?_sound e hpe) (ihf hff)
        | exact PayloadEffective.mul_both (ihe heff) (ihf hff)
  | max e f ihe ihf =>
      simp [MeasureExpr.payloadEffective?]
      intro h
      cases h with
      | inl he => exact PayloadEffective.max_left (ihe he)
      | inr hf => exact PayloadEffective.max_right (ihf hf)
  | smul n e ihe =>
      simp [MeasureExpr.payloadEffective?]
      intro hn he
      exact PayloadEffective.smul_pos hn (ihe he)

theorem payloadEffective?_complete {e : MeasureExpr}
    (h : PayloadEffective e) :
    e.payloadEffective? = true := by
  induction h with
  | payload =>
      rfl
  | add_left h ih =>
      simp [MeasureExpr.payloadEffective?, ih]
  | add_right h ih =>
      simp [MeasureExpr.payloadEffective?, ih]
  | max_left h ih =>
      simp [MeasureExpr.payloadEffective?, ih]
  | max_right h ih =>
      simp [MeasureExpr.payloadEffective?, ih]
  | smul_pos hn h ih =>
      simp [MeasureExpr.payloadEffective?, hn, ih]
  | mul_left_floor he hf ihe =>
      have hfcheck := positiveFloor?_complete hf
      simp [MeasureExpr.payloadEffective?, ihe, hfcheck]
  | mul_right_floor he hf ihf =>
      have hecheck := positiveFloor?_complete he
      simp [MeasureExpr.payloadEffective?, hecheck, ihf]
  | mul_both he hf ihe ihf =>
      simp [MeasureExpr.payloadEffective?, ihe, ihf]

theorem positiveFloor?_eq_true_iff (e : MeasureExpr) :
    e.positiveFloor? = true ↔ PayloadPositiveFloor e :=
  ⟨positiveFloor?_sound e, fun h => positiveFloor?_complete h⟩

theorem payloadEffective?_eq_true_iff (e : MeasureExpr) :
    e.payloadEffective? = true ↔ PayloadEffective e :=
  ⟨payloadEffective?_sound e, fun h => payloadEffective?_complete h⟩

/-! ### The barrier (blocked side) and the counter projection (escape side) -/

/-- **Pump barrier.** A measure with unbounded payload dependence cannot orient the duplicating
step. The duplicated payload is pumpable: a fixed left-hand-side value `m (c+1) p` cannot strictly
exceed the unbounded family `{ m c (p + L) : L ≥ 1 }`. The proof uses unboundedness alone. -/
theorem barrier {m : Nat → Nat → Nat} (hunb : PayloadUnbounded m) :
    ¬ OrientsDupStep m := by
  intro horients
  obtain ⟨L, hL1, hLb⟩ := hunb 0 0 (m 1 0)
  have ho := horients 0 0 L hL1
  simp only [Nat.zero_add] at ho hLb
  omega

/-- **Grammar-closure barrier.** Every grammar measure whose payload dependence is unbounded is
blocked: it cannot orient the duplicating step. This subsumes the enumerated direct-measure classes
by one structural induction (`eval_payloadMonotone`) plus the pump. -/
theorem grammar_measure_blocked (e : MeasureExpr) (hunb : PayloadUnbounded e.eval) :
    ¬ OrientsDupStep e.eval :=
  barrier hunb

/-- The bare payload coordinate has unbounded payload dependence. -/
theorem payload_payloadUnbounded : PayloadUnbounded MeasureExpr.payload.eval := by
  intro c p N
  refine ⟨N + 1, by omega, ?_⟩
  show N ≤ p + (N + 1)
  omega

/-- Effective payload dependence is enough to discharge the payload-unboundedness hypothesis of
`grammar_measure_blocked`. This is the scalar grammar closure without one-off family witnesses. -/
theorem payloadEffective_payloadUnbounded {e : MeasureExpr}
    (h : PayloadEffective e) :
    PayloadUnbounded e.eval := by
  induction h with
  | payload =>
      exact payload_payloadUnbounded
  | add_left h ih =>
      rename_i e f
      intro c p N
      obtain ⟨L, hL1, hN⟩ := ih c p N
      refine ⟨L, hL1, ?_⟩
      simp [MeasureExpr.eval]
      omega
  | add_right h ih =>
      rename_i e f
      intro c p N
      obtain ⟨L, hL1, hN⟩ := ih c p N
      refine ⟨L, hL1, ?_⟩
      simp [MeasureExpr.eval]
      omega
  | max_left h ih =>
      rename_i e f
      intro c p N
      obtain ⟨L, hL1, hN⟩ := ih c p N
      refine ⟨L, hL1, ?_⟩
      simpa [MeasureExpr.eval] using
        (le_trans hN
          (le_max_left (e.eval c (p + L)) (f.eval c (p + L))))
  | max_right h ih =>
      rename_i e f
      intro c p N
      obtain ⟨L, hL1, hN⟩ := ih c p N
      refine ⟨L, hL1, ?_⟩
      simpa [MeasureExpr.eval] using
        (le_trans hN
          (le_max_right (e.eval c (p + L)) (f.eval c (p + L))))
  | smul_pos hn h ih =>
      rename_i n e
      intro c p N
      obtain ⟨L, hL1, hN⟩ := ih c p N
      refine ⟨L, hL1, ?_⟩
      have hn1 : 1 ≤ n := Nat.succ_le_of_lt hn
      have hmul :
          e.eval c (p + L) ≤ n * e.eval c (p + L) := by
        simpa [Nat.one_mul] using
          (Nat.mul_le_mul_right (e.eval c (p + L)) hn1)
      exact le_trans hN hmul
  | mul_left_floor he hf ihe =>
      rename_i e f
      intro c p N
      obtain ⟨L, hL1, hN⟩ := ihe c p N
      refine ⟨L, hL1, ?_⟩
      have hfloor := payloadPositiveFloor_eval_ge_one hf c (p + L)
      have hmul :
          e.eval c (p + L) ≤
            e.eval c (p + L) * f.eval c (p + L) := by
        simpa [Nat.mul_one] using
          (Nat.mul_le_mul_left (e.eval c (p + L)) hfloor)
      exact le_trans hN hmul
  | mul_right_floor he hf ihf =>
      rename_i e f
      intro c p N
      obtain ⟨L, hL1, hN⟩ := ihf c p N
      refine ⟨L, hL1, ?_⟩
      have hfloor := payloadPositiveFloor_eval_ge_one he c (p + L)
      have hmul :
          f.eval c (p + L) ≤ e.eval c (p + L) * f.eval c (p + L) := by
        have hmul' :
            f.eval c (p + L) ≤ f.eval c (p + L) * e.eval c (p + L) := by
          simpa [Nat.mul_one] using
            (Nat.mul_le_mul_left (f.eval c (p + L)) hfloor)
        simpa [Nat.mul_comm] using hmul'
      exact le_trans hN hmul
  | mul_both he hf ihe ihf =>
      rename_i e f
      intro c p N
      obtain ⟨L₁, hL₁1, hN₁⟩ := ihe c p N
      obtain ⟨L₂, hL₂1, hOne₂⟩ := ihf c p 1
      let L := Nat.max L₁ L₂
      refine ⟨L, le_trans hL₁1 (le_max_left L₁ L₂), ?_⟩
      have hLe₁ : p + L₁ ≤ p + L :=
        Nat.add_le_add_left (le_max_left L₁ L₂) p
      have hLe₂ : p + L₂ ≤ p + L :=
        Nat.add_le_add_left (le_max_right L₁ L₂) p
      have he_mono :=
        eval_payloadMonotone e c (p + L₁) (p + L) hLe₁
      have hf_mono :=
        eval_payloadMonotone f c (p + L₂) (p + L) hLe₂
      have hN_e : N ≤ e.eval c (p + L) := le_trans hN₁ he_mono
      have h1_f : 1 ≤ f.eval c (p + L) := le_trans hOne₂ hf_mono
      have hmul :
          e.eval c (p + L) ≤
            e.eval c (p + L) * f.eval c (p + L) := by
        simpa [Nat.mul_one] using
          (Nat.mul_le_mul_left (e.eval c (p + L)) h1_f)
      exact le_trans hN_e hmul

/-- **Effective-payload grammar barrier.** Every scalar grammar expression with a syntactic
effective-payload certificate is blocked. No separate unboundedness witness is needed for each
family. -/
theorem payloadEffective_measures_blocked (e : MeasureExpr)
    (h : PayloadEffective e) :
    ¬ OrientsDupStep e.eval :=
  grammar_measure_blocked e (payloadEffective_payloadUnbounded h)

/-- Executable checker bridge: if the reflected checker accepts an expression as effectively
payload-dependent, Lean proves the expression cannot orient the duplicating step. -/
theorem payloadEffective?_blocked (e : MeasureExpr)
    (h : e.payloadEffective? = true) :
    ¬ OrientsDupStep e.eval :=
  payloadEffective_measures_blocked e (payloadEffective?_sound e h)

/-- **Canonical blocked measure.** The payload measure itself is blocked. Any grammar measure that
dominates the payload (a sum, product, max, or scalar multiple that keeps payload dependence) is
blocked the same way. -/
theorem payload_blocked : ¬ OrientsDupStep MeasureExpr.payload.eval :=
  grammar_measure_blocked MeasureExpr.payload payload_payloadUnbounded

/-- The zero scalar deliberately erases payload dependence; it is not an effective-payload
certificate. This prevents the false `usesPayload -> PayloadUnbounded` shortcut. -/
theorem zero_smul_payload_not_payloadEffective :
    ¬ PayloadEffective (MeasureExpr.smul 0 MeasureExpr.payload) := by
  intro h
  cases h with
  | smul_pos hn _ => omega

/-- **Escape side.** The payload-blind counter projection orients the duplicating step: the counter
strictly drops at every step regardless of the duplicated payload. This is the dependency-pair /
counter-projection route across the orientation boundary. -/
theorem counter_orients : OrientsDupStep MeasureExpr.counter.eval := by
  intro c p L _
  show c < c + 1
  omega

/-- Effective-payload closure plus the counter escape in one public theorem. -/
theorem payloadEffective_orientation_boundary :
    (∀ e : MeasureExpr, PayloadEffective e → ¬ OrientsDupStep e.eval)
      ∧ OrientsDupStep MeasureExpr.counter.eval :=
  ⟨payloadEffective_measures_blocked, counter_orients⟩

/-- **Orientation boundary, grammar form.** The bare payload coordinate is blocked, while the
payload-blind counter projection orients the step. -/
theorem orientation_boundary_grammar :
    (¬ OrientsDupStep MeasureExpr.payload.eval) ∧ OrientsDupStep MeasureExpr.counter.eval :=
  ⟨payload_blocked, counter_orients⟩

/-! ### Literal closure: orientation requires payload-blindness

`grammar_measure_blocked` and `payloadEffective_measures_blocked` are the *forward* barrier: effective
or unbounded payload dependence blocks orientation. This section proves the semantic necessary
condition directly: every orienting grammar measure is payload-blind. The mechanism is a structural
dichotomy. Because the grammar has operations that preserve growth rather than cap it, every fixed-
counter payload section is either constant or unbounded. The payload pump excludes the unbounded
case under `OrientsDupStep`, forcing constancy. The syntax-free carrier-level form
(`monotone_unbounded_section_not_orients`) remains in the universal layer because it does not mention
this grammar. -/

/-- A measure is payload-blind when, at every fixed counter, its value does not depend on the payload
coordinate. This is the only way a grammar measure can orient the duplicating step. -/
def PayloadBlind (m : Nat → Nat → Nat) : Prop :=
  ∀ c p p', m c p = m c p'

/-- **Structural dichotomy.** At every fixed counter `c`, a grammar measure's payload section is
either constant or unbounded: the grammar has no cap-from-above operation, so no section is bounded
and nonconstant. Induction over the seven constructors; payload-monotonicity drives the product and
scalar cases. -/
theorem eval_section_const_or_unbounded (e : MeasureExpr) (c : Nat) :
    (∀ p p', e.eval c p = e.eval c p') ∨ (∀ N, ∃ p, N ≤ e.eval c p) := by
  induction e with
  | counter => left; intro p p'; rfl
  | payload => right; intro N; exact ⟨N, Nat.le_refl N⟩
  | const n => left; intro p p'; rfl
  | add e f ihe ihf =>
      rcases ihe with he | he
      · rcases ihf with hf | hf
        · left; intro p p'
          show e.eval c p + f.eval c p = e.eval c p' + f.eval c p'
          rw [he p p', hf p p']
        · right; intro N
          obtain ⟨p, hp⟩ := hf N
          exact ⟨p, le_trans hp (Nat.le_add_left _ _)⟩
      · right; intro N
        obtain ⟨p, hp⟩ := he N
        exact ⟨p, le_trans hp (Nat.le_add_right _ _)⟩
  | mul e f ihe ihf =>
      have me := eval_payloadMonotone e c
      have mf := eval_payloadMonotone f c
      rcases ihe with he | he
      · rcases ihf with hf | hf
        · left; intro p p'
          show e.eval c p * f.eval c p = e.eval c p' * f.eval c p'
          rw [he p p', hf p p']
        · rcases Nat.eq_zero_or_pos (e.eval c 0) with ha | ha
          · left; intro p p'
            show e.eval c p * f.eval c p = e.eval c p' * f.eval c p'
            rw [he p 0, he p' 0, ha, Nat.zero_mul, Nat.zero_mul]
          · right; intro N
            obtain ⟨p, hp⟩ := hf N
            refine ⟨p, ?_⟩
            show N ≤ e.eval c p * f.eval c p
            rw [he p 0]
            calc N ≤ f.eval c p := hp
              _ ≤ e.eval c 0 * f.eval c p := Nat.le_mul_of_pos_left _ ha
      · rcases ihf with hf | hf
        · rcases Nat.eq_zero_or_pos (f.eval c 0) with hb | hb
          · left; intro p p'
            show e.eval c p * f.eval c p = e.eval c p' * f.eval c p'
            rw [hf p 0, hf p' 0, hb, Nat.mul_zero, Nat.mul_zero]
          · right; intro N
            obtain ⟨p, hp⟩ := he N
            refine ⟨p, ?_⟩
            show N ≤ e.eval c p * f.eval c p
            rw [hf p 0]
            calc N ≤ e.eval c p := hp
              _ ≤ e.eval c p * f.eval c 0 := Nat.le_mul_of_pos_right _ hb
        · right; intro N
          obtain ⟨q, hq⟩ := hf 1
          obtain ⟨r, hr⟩ := he N
          refine ⟨q + r, ?_⟩
          show N ≤ e.eval c (q + r) * f.eval c (q + r)
          have hfpos : 1 ≤ f.eval c (q + r) := le_trans hq (mf q (q + r) (Nat.le_add_right _ _))
          have hege : N ≤ e.eval c (q + r) := le_trans hr (me r (q + r) (Nat.le_add_left _ _))
          calc N ≤ e.eval c (q + r) := hege
            _ ≤ e.eval c (q + r) * f.eval c (q + r) := Nat.le_mul_of_pos_right _ hfpos
  | max e f ihe ihf =>
      rcases ihe with he | he
      · rcases ihf with hf | hf
        · left; intro p p'
          show Nat.max (e.eval c p) (f.eval c p) = Nat.max (e.eval c p') (f.eval c p')
          rw [he p p', hf p p']
        · right; intro N
          obtain ⟨p, hp⟩ := hf N
          exact ⟨p, le_trans hp (Nat.le_max_right _ _)⟩
      · right; intro N
        obtain ⟨p, hp⟩ := he N
        exact ⟨p, le_trans hp (Nat.le_max_left _ _)⟩
  | smul n e ihe =>
      rcases ihe with he | he
      · left; intro p p'
        show n * e.eval c p = n * e.eval c p'
        rw [he p p']
      · rcases Nat.eq_zero_or_pos n with hn | hn
        · left; intro p p'
          show n * e.eval c p = n * e.eval c p'
          rw [hn, Nat.zero_mul, Nat.zero_mul]
        · right; intro N
          obtain ⟨p, hp⟩ := he N
          refine ⟨p, ?_⟩
          show N ≤ n * e.eval c p
          calc N ≤ e.eval c p := hp
            _ ≤ n * e.eval c p := Nat.le_mul_of_pos_left _ hn

/-- **Necessary condition.** A grammar measure that orients the duplicating step is payload-blind.
The proof derives payload-blindness directly from orientation and the section dichotomy, without an
effective-payload certificate. -/
theorem orients_implies_payload_blind (e : MeasureExpr)
    (h : OrientsDupStep e.eval) : PayloadBlind e.eval := by
  intro c p p'
  rcases eval_section_const_or_unbounded e c with hconst | hunb
  · exact hconst p p'
  · exfalso
    obtain ⟨q, hq⟩ := hunb (e.eval (c + 1) 0 + 1)
    have ho := h c 0 (q + 1) (Nat.succ_le_succ (Nat.zero_le q))
    have hge : e.eval c q ≤ e.eval c (0 + (q + 1)) :=
      eval_payloadMonotone e c q (0 + (q + 1)) (by omega)
    omega

/-- **Contrapositive.** Any grammar measure that reads the payload coordinate (is not payload-blind)
cannot orient the duplicating step. This is the orientation boundary for the whole scalar grammar,
with no per-family unboundedness obligation. -/
theorem payload_reading_measure_blocked (e : MeasureExpr)
    (h : ¬ PayloadBlind e.eval) : ¬ OrientsDupStep e.eval :=
  fun ho => h (orients_implies_payload_blind e ho)

/-- The counter projection is payload-blind. Together with `counter_orients`, this supplies an
orienting witness inside the payload-blind class. -/
theorem counter_is_payload_blind : PayloadBlind MeasureExpr.counter.eval :=
  fun _ _ _ => rfl

/-- The `PayloadUnbounded` hypothesis of `grammar_measure_blocked` is one way to witness
non-blindness, so the earlier hypothesis form is the special case of the literal closure. -/
theorem unbounded_not_payload_blind (e : MeasureExpr)
    (hunb : PayloadUnbounded e.eval) : ¬ PayloadBlind e.eval := by
  intro hblind
  obtain ⟨L, _, hL⟩ := hunb 0 0 (e.eval 0 0 + 1)
  have hb : e.eval 0 (0 + L) = e.eval 0 0 := hblind 0 (0 + L) 0
  omega

/-- **Executable checker, sound for non-blindness.** If the reflected effective-payload checker
accepts an expression, the expression is not payload-blind, hence is blocked by
`payload_reading_measure_blocked`. The checker is a sound sufficient condition for semantic
payload-dependence; it is not complete, since `MeasureExpr.mul MeasureExpr.payload MeasureExpr.counter`
reads the payload at every positive counter yet is rejected (its counter cofactor is zero at counter
zero). So this is a one-directional sufficient condition, not an equivalence. -/
theorem payloadEffective?_not_payloadBlind (e : MeasureExpr)
    (h : e.payloadEffective? = true) : ¬ PayloadBlind e.eval :=
  unbounded_not_payload_blind e (payloadEffective_payloadUnbounded (payloadEffective?_sound e h))

