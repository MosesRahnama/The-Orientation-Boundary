import Mathlib.Data.Setoid.Partition
import Mathlib.Order.Antisymmetrization
import OperatorKO7.Meta.OperationalInexpressibility.TargetKernelQuotient

/-!
# The license lattice

An observer's kernel is an equivalence relation on the source. Observer refinement is inclusion
of kernels, and the license criterion is inclusion of the observer kernel in the target kernel.
Every equivalence relation is the kernel of its quotient map, so observers modulo equal kernels,
ordered by refinement, are order-isomorphic to the lattice of equivalence relations on the source,
and through Mathlib's `Setoid.Partition.orderIso` to the lattice of partitions.

In that lattice the joint observer of two observers has the infimum kernel and the common
coarsening, the quotient by the equivalence relation generated by the two kernels, has the supremum
kernel. A target is licensed by the common coarsening exactly when it is licensed by each observer,
for arbitrary families of observers as well as for pairs. Two worlds are identified by the common
coarsening exactly when a finite chain of steps, each preserving one of the two observations,
connects them. A target licensed by either observer is licensed by the joint observer, and the
parity of two Boolean coordinates shows that the joint observer licenses strictly more.

Relation: equality of observer outputs; inclusion of equivalence relations.
Property: order isomorphism, lattice operations, and their license theories.
Trust: kernel only; quotient equality uses `Quot.sound`, the inverse of the isomorphism uses
quotient representatives.
Scope: arbitrary source type; observations for the isomorphism lie in the source universe;
license statements allow arbitrary observation and target universes.
-/

set_option autoImplicit false

namespace OperatorKO7.Meta.OperationalInexpressibility.LicenseLattice

open OperatorKO7.Meta.OperationalInexpressibility.ObserverKernel
open OperatorKO7.Meta.OperationalInexpressibility.DirectGrammarBoundary
open OperatorKO7.Meta.OperationalInexpressibility.LicenseCriterion
open OperatorKO7.Meta.OperationalInexpressibility.TargetKernel

universe u v w z

/-! ## Kernels as elements of the partition lattice -/

/-- The kernel of an observer as an equivalence relation on the source. -/
def observerKernel {X : Type u} {Q : Type v} (q : X → Q) : Setoid X :=
  Setoid.ker q

theorem observerKernel_apply {X : Type u} {Q : Type v} (q : X → Q) (x y : X) :
    observerKernel q x y ↔ q x = q y :=
  Iff.rfl

/-- Observer refinement is inclusion of kernels. -/
theorem observerRefines_iff_kernel_le {X : Type u} {Q₁ : Type v} {Q₂ : Type w}
    (q₁ : X → Q₁) (q₂ : X → Q₂) :
    ObserverRefines q₁ q₂ ↔ observerKernel q₁ ≤ observerKernel q₂ :=
  ⟨fun h _ _ hxy => h hxy, fun h _ _ hxy => h hxy⟩

/-- The license criterion is inclusion of the observer kernel in the target kernel. -/
theorem licensed_iff_kernel_le {X : Type u} {Q : Type v} {V : Type w}
    (q : X → Q) (P : X → V) :
    Licensed q P ↔ observerKernel q ≤ observerKernel P :=
  ⟨fun h x y hxy => h x y hxy, fun h _ _ hxy => h hxy⟩

/-- Every equivalence relation is the kernel of its quotient map. -/
theorem observerKernel_quotientMk {X : Type u} (s : Setoid X) :
    observerKernel (Quotient.mk s) = s :=
  Setoid.ext fun _ _ => Quotient.eq

/-! ## Observers modulo kernel are the partition lattice -/

/-- An observer on `X` with observations in the universe of `X`. -/
def Observer (X : Type u) : Type (u + 1) :=
  Σ Q : Type u, X → Q

namespace Observer

variable {X : Type u}

/-- The refinement preorder: `o₁ ≤ o₂` when `o₁` refines `o₂`. -/
instance : Preorder (Observer X) where
  le o₁ o₂ := ObserverRefines o₁.2 o₂.2
  le_refl o := ObserverRefines.refl o.2
  le_trans _ _ _ h₁₂ h₂₃ := fun hxy => h₂₃ (h₁₂ hxy)

/-- The kernel of an observer. -/
def kernel (o : Observer X) : Setoid X :=
  observerKernel o.2

theorem le_iff_kernel_le (o₁ o₂ : Observer X) : o₁ ≤ o₂ ↔ o₁.kernel ≤ o₂.kernel := by
  show ObserverRefines o₁.2 o₂.2 ↔ observerKernel o₁.2 ≤ observerKernel o₂.2
  exact observerRefines_iff_kernel_le o₁.2 o₂.2

/-- The quotient observer of an equivalence relation. -/
def ofSetoid (s : Setoid X) : Observer X :=
  ⟨Quotient s, Quotient.mk s⟩

theorem kernel_ofSetoid (s : Setoid X) : (ofSetoid s).kernel = s :=
  observerKernel_quotientMk s

/-- The kernel map is surjective. -/
theorem kernel_surjective : Function.Surjective (kernel : Observer X → Setoid X) :=
  fun s => ⟨ofSetoid s, kernel_ofSetoid s⟩

end Observer

/-- **Observers modulo kernel are the lattice of equivalence relations.** The refinement preorder
on observers, with mutually refining observers identified, is order-isomorphic to `Setoid X`
ordered by inclusion. -/
def observerKernelPartitionEquiv {X : Type u} :
    Antisymmetrization (Observer X) (· ≤ ·) ≃o Setoid X where
  toFun := Quotient.lift (fun o : Observer X => o.kernel) fun o₁ o₂ h =>
    le_antisymm ((Observer.le_iff_kernel_le o₁ o₂).1 h.1) ((Observer.le_iff_kernel_le o₂ o₁).1 h.2)
  invFun s := toAntisymmetrization (· ≤ ·) (Observer.ofSetoid s)
  left_inv a := Quotient.inductionOn a fun _ => Quotient.sound
    ⟨(Observer.le_iff_kernel_le _ _).2 (le_of_eq (Observer.kernel_ofSetoid _)),
      (Observer.le_iff_kernel_le _ _).2 (ge_of_eq (Observer.kernel_ofSetoid _))⟩
  right_inv s := Observer.kernel_ofSetoid s
  map_rel_iff' {a b} := Quotient.inductionOn₂ a b fun o₁ o₂ =>
    (Observer.le_iff_kernel_le o₁ o₂).symm

/-- The isomorphism sends the class of an observer to its kernel. -/
theorem observerKernelPartitionEquiv_toAntisymmetrization {X : Type u} (o : Observer X) :
    observerKernelPartitionEquiv (toAntisymmetrization (· ≤ ·) o) = o.kernel :=
  rfl

/-- Observers modulo kernel are order-isomorphic to the partitions of the source. -/
noncomputable def observerPartitionOrderIso {X : Type u} :
    Antisymmetrization (Observer X) (· ≤ ·) ≃o { C : Set (Set X) // Setoid.IsPartition C } :=
  observerKernelPartitionEquiv.trans (Setoid.Partition.orderIso X)

/-! ## Joint observer and common coarsening -/

/-- The joint observer of two observers. -/
def jointPair {X : Type u} {Q₁ : Type v} {Q₂ : Type w} (q₁ : X → Q₁) (q₂ : X → Q₂) :
    X → Q₁ × Q₂ :=
  fun x => (q₁ x, q₂ x)

/-- The joint observer has the infimum kernel. -/
theorem observerKernel_jointPair {X : Type u} {Q₁ : Type v} {Q₂ : Type w}
    (q₁ : X → Q₁) (q₂ : X → Q₂) :
    observerKernel (jointPair q₁ q₂) = observerKernel q₁ ⊓ observerKernel q₂ :=
  Setoid.ext fun _ _ => Prod.ext_iff

/-- The joint observer of an arbitrary family has the infimum kernel. -/
theorem observerKernel_jointObserver {X : Type u} {I : Type z} {Q : I → Type v}
    (q : (i : I) → X → Q i) :
    observerKernel (jointObserver q) = ⨅ i, observerKernel (q i) := by
  apply le_antisymm
  · exact le_iInf fun i _ _ hxy => congrFun hxy i
  · intro x y hxy
    exact funext fun i => (iInf_le (fun i => observerKernel (q i)) i) hxy

/-- The common coarsening of two observers: the quotient by the equivalence relation generated by
their kernels. -/
def commonCoarsening {X : Type u} {Q₁ : Type v} {Q₂ : Type w} (q₁ : X → Q₁) (q₂ : X → Q₂) :
    X → Quotient (observerKernel q₁ ⊔ observerKernel q₂) :=
  Quotient.mk _

/-- The common coarsening has the supremum kernel. -/
theorem observerKernel_commonCoarsening {X : Type u} {Q₁ : Type v} {Q₂ : Type w}
    (q₁ : X → Q₁) (q₂ : X → Q₂) :
    observerKernel (commonCoarsening q₁ q₂) = observerKernel q₁ ⊔ observerKernel q₂ :=
  observerKernel_quotientMk _

/-- The common coarsening of an arbitrary family of observers. -/
def commonCoarseningFamily {X : Type u} {I : Type z} {Q : I → Type v}
    (q : (i : I) → X → Q i) : X → Quotient (⨆ i, observerKernel (q i)) :=
  Quotient.mk _

/-- The common coarsening of a family has the supremum kernel. -/
theorem observerKernel_commonCoarseningFamily {X : Type u} {I : Type z} {Q : I → Type v}
    (q : (i : I) → X → Q i) :
    observerKernel (commonCoarseningFamily q) = ⨆ i, observerKernel (q i) :=
  observerKernel_quotientMk _

/-- **License theory of the meet.** A target is licensed by the common coarsening exactly when it
is licensed by each of the two observers. -/
theorem licensed_meet_iff {X : Type u} {Q₁ : Type v} {Q₂ : Type w} {V : Type z}
    (q₁ : X → Q₁) (q₂ : X → Q₂) (P : X → V) :
    Licensed (commonCoarsening q₁ q₂) P ↔ Licensed q₁ P ∧ Licensed q₂ P := by
  rw [licensed_iff_kernel_le, observerKernel_commonCoarsening, sup_le_iff,
    ← licensed_iff_kernel_le, ← licensed_iff_kernel_le]

/-- **License theory of the meet of a family.** A target is licensed by the common coarsening of a
family exactly when every observer of the family licenses it. -/
theorem licensed_meetFamily_iff {X : Type u} {I : Type z} {Q : I → Type v} {V : Type w}
    (q : (i : I) → X → Q i) (P : X → V) :
    Licensed (commonCoarseningFamily q) P ↔ ∀ i, Licensed (q i) P := by
  rw [licensed_iff_kernel_le, observerKernel_commonCoarseningFamily, iSup_le_iff]
  exact forall_congr' fun i => (licensed_iff_kernel_le (q i) P).symm

/-- The common coarsening is the finest observer refined by both observers. -/
theorem commonCoarsening_greatest_lower {X : Type u} {Q₁ : Type v} {Q₂ : Type w} {R : Type z}
    (q₁ : X → Q₁) (q₂ : X → Q₂) :
    ObserverRefines q₁ (commonCoarsening q₁ q₂) ∧ ObserverRefines q₂ (commonCoarsening q₁ q₂) ∧
      ∀ r : X → R, ObserverRefines q₁ r → ObserverRefines q₂ r →
        ObserverRefines (commonCoarsening q₁ q₂) r := by
  simp only [observerRefines_iff_kernel_le, observerKernel_commonCoarsening]
  exact ⟨le_sup_left, le_sup_right, fun _ h₁ h₂ => sup_le h₁ h₂⟩

/-- **Chain characterization of the meet.** Two worlds are identified by the common coarsening
exactly when the equivalence closure of "one of the two observations agrees" connects them. -/
theorem commonCoarsening_eq_iff_eqvGen {X : Type u} {Q₁ : Type v} {Q₂ : Type w}
    (q₁ : X → Q₁) (q₂ : X → Q₂) (x y : X) :
    commonCoarsening q₁ q₂ x = commonCoarsening q₁ q₂ y ↔
      Relation.EqvGen (fun a b => q₁ a = q₁ b ∨ q₂ a = q₂ b) x y := by
  unfold commonCoarsening
  rw [Quotient.eq, Setoid.sup_eq_eqvGen]
  rfl

/-- **License of the join.** A target licensed by either observer is licensed by the joint
observer. -/
theorem licensed_join_of_either {X : Type u} {Q₁ : Type v} {Q₂ : Type w} {V : Type z}
    (q₁ : X → Q₁) (q₂ : X → Q₂) (P : X → V) (h : Licensed q₁ P ∨ Licensed q₂ P) :
    Licensed (jointPair q₁ q₂) P := by
  rcases h with h | h
  · exact fun x y hxy => h x y (congrArg Prod.fst hxy)
  · exact fun x y hxy => h x y (congrArg Prod.snd hxy)

/-- Parity of two Boolean coordinates. -/
def parityTarget (x : Bool × Bool) : Bool :=
  xor x.1 x.2

/-- **Strict control for the join.** Parity is licensed by the joint observer of the two
coordinates and by neither coordinate alone. -/
theorem parity_licensed_by_join_only :
    Licensed (jointPair (Prod.fst : Bool × Bool → Bool) Prod.snd) parityTarget ∧
      ¬ Licensed (Prod.fst : Bool × Bool → Bool) parityTarget ∧
      ¬ Licensed (Prod.snd : Bool × Bool → Bool) parityTarget := by
  refine ⟨?_, ?_, ?_⟩
  · intro x y hxy
    have h1 : x.1 = y.1 := congrArg Prod.fst hxy
    have h2 : x.2 = y.2 := congrArg Prod.snd hxy
    simp only [parityTarget, h1, h2]
  · intro h
    have hbad := h (false, false) (false, true) rfl
    simp [parityTarget] at hbad
  · intro h
    have hbad := h (false, false) (true, false) rfl
    simp [parityTarget] at hbad

end OperatorKO7.Meta.OperationalInexpressibility.LicenseLattice
