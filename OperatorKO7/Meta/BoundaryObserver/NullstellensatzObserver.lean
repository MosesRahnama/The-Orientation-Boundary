import Mathlib.RingTheory.Nullstellensatz
import OperatorKO7.Meta.BoundaryObserver.MergedPair

set_option autoImplicit false

/-!
# Polynomial observers and the Nullstellensatz certificate

The zero fiber of a polynomial observer is the variety of the ideal generated by
its tests. Over an algebraically closed field, a polynomial target is constant
on that variety precisely when a constant shift belongs to the radical ideal.
Failure of that certificate gives a merged pair with different target values.

-/

namespace OperatorKO7.Meta.BoundaryObserver.NullstellensatzObserver

open OperatorKO7.Meta.BoundaryObserver.MergedPair

/-- A polynomial observer records the evaluation of each polynomial test in the family. -/
noncomputable def polynomialObserver {k σ : Type*} [CommSemiring k] {m : ℕ}
    (g : Fin m → MvPolynomial σ k) : (σ → k) → (Fin m → k) :=
  fun x i => MvPolynomial.eval x (g i)

/-- The zero fiber of a polynomial observer is the variety of the ideal generated by
its polynomial tests. -/
theorem fiber_zero_eq_zeroLocus {k σ : Type*} [Field k] {m : ℕ}
    (g : Fin m → MvPolynomial σ k) (I : Ideal (MvPolynomial σ k))
    (hgen : Ideal.span (Set.range g) = I) :
    {x : σ → k | polynomialObserver g x = 0} = MvPolynomial.zeroLocus I := by
  rw [← hgen, MvPolynomial.zeroLocus_span]
  ext x
  change polynomialObserver g x = 0 ↔
    ∀ p ∈ Set.range g, MvPolynomial.eval x p = 0
  constructor
  · intro hx p hp
    obtain ⟨i, rfl⟩ := hp
    have hi := congrFun hx i
    simpa [polynomialObserver] using hi
  · intro hx
    funext i
    simpa [polynomialObserver] using hx (g i) ⟨i, rfl⟩

/-- Over an algebraically closed field with finitely many variables, a polynomial
target is constant on a variety if and only if one constant shift lies in the
radical ideal. The equivalence includes the empty variety. -/
theorem constant_on_variety_iff_radical {k σ : Type*} [Field k] [IsAlgClosed k]
    [Finite σ] (I : Ideal (MvPolynomial σ k)) (L : MvPolynomial σ k) :
    (∃ c : k, ∀ x ∈ MvPolynomial.zeroLocus I, MvPolynomial.eval x L = c) ↔
      ∃ c : k, L - MvPolynomial.C c ∈ I.radical := by
  constructor
  · rintro ⟨c, hc⟩
    refine ⟨c, ?_⟩
    rw [← MvPolynomial.vanishingIdeal_zeroLocus_eq_radical I]
    change ∀ x ∈ MvPolynomial.zeroLocus I,
      MvPolynomial.eval x (L - MvPolynomial.C c) = 0
    intro x hx
    simp [MvPolynomial.eval_sub, hc x hx]
  · rintro ⟨c, hc⟩
    refine ⟨c, ?_⟩
    rw [← MvPolynomial.vanishingIdeal_zeroLocus_eq_radical I] at hc
    have hvan : ∀ x ∈ MvPolynomial.zeroLocus I,
        MvPolynomial.eval x (L - MvPolynomial.C c) = 0 :=
      MvPolynomial.mem_vanishingIdeal_iff.mp hc
    intro x hx
    have hzero := hvan x hx
    have hs : MvPolynomial.eval x L - c = 0 := by
      simpa [MvPolynomial.eval_sub] using hzero
    exact sub_eq_zero.mp hs

/-- Failure of every constant-shift radical certificate produces two points
in the variety with the same polynomial record and different target values. -/
theorem variety_collision {k σ : Type*} [Field k] [IsAlgClosed k] [Finite σ]
    {m : ℕ} (g : Fin m → MvPolynomial σ k)
    (I : Ideal (MvPolynomial σ k))
    (hgen : Ideal.span (Set.range g) = I) (L : MvPolynomial σ k)
    (hnot : ¬ ∃ c : k, L - MvPolynomial.C c ∈ I.radical) :
    ∃ x ∈ MvPolynomial.zeroLocus I, ∃ y ∈ MvPolynomial.zeroLocus I,
      IsMergedPair (polynomialObserver g) x y ∧
        MvPolynomial.eval x L ≠ MvPolynomial.eval y L := by
  classical
  have hnotconst :
      ¬ ∃ c : k, ∀ x ∈ MvPolynomial.zeroLocus I, MvPolynomial.eval x L = c :=
    fun h => hnot ((constant_on_variety_iff_radical I L).mp h)
  have hvary :
      ∃ x ∈ MvPolynomial.zeroLocus I, ∃ y ∈ MvPolynomial.zeroLocus I,
        MvPolynomial.eval x L ≠ MvPolynomial.eval y L := by
    by_contra h
    have hall : ∀ x ∈ MvPolynomial.zeroLocus I,
        ∀ y ∈ MvPolynomial.zeroLocus I,
          MvPolynomial.eval x L = MvPolynomial.eval y L := by
      intro x hx y hy
      by_contra hxy
      exact h ⟨x, hx, y, hy, hxy⟩
    by_cases hv : (MvPolynomial.zeroLocus I).Nonempty
    · obtain ⟨x, hx⟩ := hv
      exact hnotconst ⟨MvPolynomial.eval x L, fun y hy => hall y hy x hx⟩
    · refine hnotconst ⟨0, ?_⟩
      intro y hy
      exact (hv ⟨y, hy⟩).elim
  obtain ⟨x, hx, y, hy, hxy⟩ := hvary
  have hfiber := fiber_zero_eq_zeroLocus g I hgen
  have hobsx : polynomialObserver g x = 0 := by
    change x ∈ {z : σ → k | polynomialObserver g z = 0}
    rw [hfiber]
    exact hx
  have hobsy : polynomialObserver g y = 0 := by
    change y ∈ {z : σ → k | polynomialObserver g z = 0}
    rw [hfiber]
    exact hy
  refine ⟨x, hx, y, hy, ?_, hxy⟩
  change x ≠ y ∧ polynomialObserver g x = polynomialObserver g y
  exact ⟨fun h => hxy (congrArg (fun z : σ → k => MvPolynomial.eval z L) h),
    hobsx.trans hobsy.symm⟩

end OperatorKO7.Meta.BoundaryObserver.NullstellensatzObserver
