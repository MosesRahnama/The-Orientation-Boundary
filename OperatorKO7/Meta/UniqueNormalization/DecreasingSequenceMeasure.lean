import OperatorKO7.Meta.UniqueNormalization.DecreasingDiagramCarrier
import Mathlib.Data.Multiset.DershowitzManna

/-!
# RTA #79 route R2: labelled sequences and lexicographic-maximum peak measure

This module implements the induction substrate used by the valley proof of
decreasing diagrams. The blueprint is Zankl's formalization of van Oostrom's
Theorem 3.7: represent reductions by their label lists, map a label list to its
lexicographic-maximum multiset, and order a pair of reductions by the
Dershowitz-Manna extension of the label order.

The present file proves only the reusable sequence and measure facts needed for
that induction. It does not state the confluence theorem.

Trust: kernel checked. No external certificate or new axiom.
-/

set_option autoImplicit false

namespace OperatorKO7.Meta.UniqueNormalization

universe u

variable {State : Type u}

/-- The lexicographically ordered pair of natural coordinates underlying a
route-R2 label. -/
abbrev LevelKey := Nat ×ₗ Nat

/-- Map the explicit route-R2 label into Mathlib's lexicographic ordered pair. -/
def LevelLabel.toKey (a : LevelLabel) : LevelKey :=
  toLex (a.conditionLevel, a.unifierRank)

/-- The bundled strict order on keys is exactly the explicit route-R2 order. -/
theorem levelLabel_toKey_lt_iff {a b : LevelLabel} :
    a.toKey < b.toKey ↔ LevelLabelLt a b := by
  rfl

/-- Forget labels from a labelled relation. -/
def Unlabelled (step : LabelledStep State LevelLabel) (x y : State) : Prop :=
  ∃ a : LevelLabel, step a x y

/-- A finite reduction path retaining the exact label list. -/
inductive LPath (step : LabelledStep State LevelLabel) :
    State → State → List LevelLabel → Prop
  | refl (x : State) : LPath step x x []
  | cons {a : LevelLabel} {x y z : State} {labels : List LevelLabel} :
      step a x y → LPath step y z labels → LPath step x z (a :: labels)

/-- Concatenate two labelled paths. -/
theorem LPath.trans {step : LabelledStep State LevelLabel}
    {x y z : State} {as bs : List LevelLabel}
    (hxy : LPath step x y as) (hyz : LPath step y z bs) :
    LPath step x z (as ++ bs) := by
  induction hxy with
  | refl => simpa using hyz
  | cons hstep _ ih =>
      simpa using LPath.cons hstep (ih hyz)

/-- Append one labelled step at the end of a labelled path. -/
theorem LPath.snoc {step : LabelledStep State LevelLabel}
    {x y z : State} {labels : List LevelLabel} {a : LevelLabel}
    (hxy : LPath step x y labels) (hyz : step a y z) :
    LPath step x z (labels ++ [a]) := by
  exact hxy.trans (LPath.cons hyz (LPath.refl z))

/-- A labelled path forgets to an ordinary reflexive-transitive reduction. -/
theorem LPath.toStar {step : LabelledStep State LevelLabel}
    {x y : State} {labels : List LevelLabel}
    (h : LPath step x y labels) :
    Relation.ReflTransGen (Unlabelled step) x y := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | cons hstep _ ih =>
      exact Relation.ReflTransGen.head ⟨_, hstep⟩ ih

/-- Every ordinary finite reduction has at least one retained label list. -/
theorem exists_lPath_of_star {step : LabelledStep State LevelLabel}
    {x y : State} (h : Relation.ReflTransGen (Unlabelled step) x y) :
    ∃ labels : List LevelLabel, LPath step x y labels := by
  induction h with
  | refl => exact ⟨[], LPath.refl _⟩
  | tail _ hstep ih =>
      obtain ⟨labels, hpath⟩ := ih
      obtain ⟨a, ha⟩ := hstep
      exact ⟨labels ++ [a], hpath.snoc ha⟩

/-- Every label in a list is strictly below `a`. -/
def AllBelow (a : LevelLabel) (labels : List LevelLabel) : Prop :=
  ∀ c ∈ labels, LevelLabelLt c a

/-- Every label in a list is strictly below at least one of `a` or `b`. -/
def AllBelowEither (a b : LevelLabel) (labels : List LevelLabel) : Prop :=
  ∀ c ∈ labels, LevelLabelLt c a ∨ LevelLabelLt c b

/-- A closure generated by `< a` retains a labelled path all of whose labels are
strictly below `a`. -/
theorem exists_lPath_allBelow_of_star_stepBelow
    {step : LabelledStep State LevelLabel} {a : LevelLabel} {x y : State}
    (h : Relation.ReflTransGen (StepBelow step LevelLabelLt a) x y) :
    ∃ labels : List LevelLabel, LPath step x y labels ∧ AllBelow a labels := by
  induction h with
  | refl =>
      exact ⟨[], LPath.refl _, by intro c hc; cases hc⟩
  | tail _ hlast ih =>
      obtain ⟨labels, hpath, hall⟩ := ih
      obtain ⟨c, hca, hstep⟩ := hlast
      refine ⟨labels ++ [c], hpath.snoc hstep, ?_⟩
      intro d hd
      simp only [List.mem_append, List.mem_singleton] at hd
      rcases hd with hd | rfl
      · exact hall d hd
      · exact hca

/-- A closure generated by labels below either side of a peak retains exactly
that combined lower-label property. -/
theorem exists_lPath_allBelowEither_of_star_stepBelowEither
    {step : LabelledStep State LevelLabel} {a b : LevelLabel} {x y : State}
    (h : Relation.ReflTransGen (StepBelowEither step LevelLabelLt a b) x y) :
    ∃ labels : List LevelLabel,
      LPath step x y labels ∧ AllBelowEither a b labels := by
  induction h with
  | refl =>
      exact ⟨[], LPath.refl _, by intro c hc; cases hc⟩
  | tail _ hlast ih =>
      obtain ⟨labels, hpath, hall⟩ := ih
      obtain ⟨c, hcab, hstep⟩ := hlast
      refine ⟨labels ++ [c], hpath.snoc hstep, ?_⟩
      intro d hd
      simp only [List.mem_append, List.mem_singleton] at hd
      rcases hd with hd | rfl
      · exact hall d hd
      · exact hcab

/-- Remove from a multiset every key strictly below `a`. This is Zankl's
multiset-minus-downset operation specialized to the route-R2 linear order. -/
def removeBelow (M : Multiset LevelKey) (a : LevelKey) : Multiset LevelKey :=
  M.filter (fun x => ¬ x < a)

/-- Lexicographic maximum measure of a label sequence. -/
def lexMax : List LevelLabel → Multiset LevelKey
  | [] => 0
  | a :: labels => {a.toKey} + removeBelow (lexMax labels) a.toKey

@[simp] theorem lexMax_nil : lexMax [] = 0 := rfl

@[simp] theorem lexMax_cons (a : LevelLabel) (labels : List LevelLabel) :
    lexMax (a :: labels) = {a.toKey} + removeBelow (lexMax labels) a.toKey := rfl

@[simp] theorem lexMax_singleton (a : LevelLabel) :
    lexMax [a] = {a.toKey} := by
  simp [lexMax, removeBelow]

/-- Every key retained by `lexMax` comes from an actual label in the source
sequence. -/
theorem mem_lexMax_source {labels : List LevelLabel} {x : LevelKey}
    (hx : x ∈ lexMax labels) :
    ∃ a ∈ labels, x = a.toKey := by
  induction labels with
  | nil => simp at hx
  | cons a labels ih =>
      simp only [lexMax_cons, Multiset.mem_add, Multiset.mem_singleton,
        removeBelow, Multiset.mem_filter] at hx
      rcases hx with hxa | ⟨hx, _⟩
      · exact ⟨a, by simp, hxa⟩
      · obtain ⟨b, hb, hxb⟩ := ih hx
        exact ⟨b, by simp [hb], hxb⟩

/-- If all labels of a sequence are below `a`, its lexicographic-maximum
multiset is strictly below the singleton `a` in Dershowitz-Manna order. -/
theorem lexMax_dm_lt_singleton_of_allBelow
    {a : LevelLabel} {labels : List LevelLabel} (h : AllBelow a labels) :
    Multiset.IsDershowitzMannaLT (lexMax labels) ({a.toKey} : Multiset LevelKey) := by
  refine ⟨0, lexMax labels, {a.toKey}, by simp, by simp, by simp, ?_⟩
  intro y hy
  obtain ⟨c, hc, rfl⟩ := mem_lexMax_source hy
  exact ⟨a.toKey, by simp, levelLabel_toKey_lt_iff.mpr (h c hc)⟩

/-- If every label is below one of the two peak labels, its lexicographic-maximum
multiset is strictly below the two-label multiset. -/
theorem lexMax_dm_lt_pair_of_allBelowEither
    {a b : LevelLabel} {labels : List LevelLabel} (h : AllBelowEither a b labels) :
    Multiset.IsDershowitzMannaLT (lexMax labels)
      ({a.toKey, b.toKey} : Multiset LevelKey) := by
  refine ⟨0, lexMax labels, {a.toKey, b.toKey}, by simp, by simp, by simp, ?_⟩
  intro y hy
  obtain ⟨c, hc, rfl⟩ := mem_lexMax_source hy
  rcases h c hc with hca | hcb
  · exact ⟨a.toKey, by simp, levelLabel_toKey_lt_iff.mpr hca⟩
  · exact ⟨b.toKey, by simp, levelLabel_toKey_lt_iff.mpr hcb⟩

/-- Measure of a two-arm labelled peak. -/
def peakMeasure (p : List LevelLabel × List LevelLabel) : Multiset LevelKey :=
  lexMax p.1 + lexMax p.2

/-- The well-founded peak-extension relation used by the full decreasing-diagram
induction. -/
def PeakMeasureLt :
    (List LevelLabel × List LevelLabel) →
      (List LevelLabel × List LevelLabel) → Prop :=
  InvImage Multiset.IsDershowitzMannaLT peakMeasure

/-- The route-R2 peak measure is well-founded. -/
theorem peakMeasureLt_wellFounded : WellFounded PeakMeasureLt :=
  InvImage.wf peakMeasure Multiset.wellFounded_isDershowitzMannaLT

end OperatorKO7.Meta.UniqueNormalization

