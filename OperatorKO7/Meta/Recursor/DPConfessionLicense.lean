import OperatorKO7.Kernel
import OperatorKO7.Meta.Recursor.CircularIdentity
import OperatorKO7.Meta.Recursor.PayloadGrowthBlindness

/-!
# Dependency-Pair Compatibility Carriers

This module preserves identifiers used by API clients. Its formal content is
limited to a closed term syntax, a constant collapse map, a witness that the map identifies
two distinct terms, a record carrying diagnostic text, and a mass-growth theorem imported
from `PayloadGrowthBlindness`.

The theorem-backed free-algebra and transformed-call results are provided by
`OperatorKO7.Meta.Recursor.DPConfessionLicenseUnconditional`. The declarations
in this module have compatibility scope: constant-map noninjectivity, diagnostic
metadata, and the imported `MassIndistinguishable` proposition.
-/

open OperatorKO7
open OperatorKO7.Trace

namespace OperatorKO7.Meta.Recursor.DPConfessionLicense

open OperatorKO7.Meta.Recursor.CircularIdentity
open OperatorKO7.Meta.Recursor.PayloadGrowthBlindness

/-- Closed terms generated by seven constructors corresponding to the displayed KO7 syntax. -/
inductive RecursorTerm : Type
  | void  : RecursorTerm
  | delta : RecursorTerm → RecursorTerm
  | integrate : RecursorTerm → RecursorTerm
  | merge : RecursorTerm → RecursorTerm → RecursorTerm
  | app : RecursorTerm → RecursorTerm → RecursorTerm
  | recR : RecursorTerm → RecursorTerm → RecursorTerm → RecursorTerm
  | eqWit : RecursorTerm → RecursorTerm → RecursorTerm
  deriving DecidableEq, Repr

/-- Constant map to `RecursorTerm.void`. It supplies the equality component of
the two-term witness below; constructor-preservation laws require a separate
homomorphism structure. -/
def dpCollapseToVoid : RecursorTerm → RecursorTerm := fun _ => RecursorTerm.void

/-- The constant collapse map identifies a pair of distinct closed terms. The
retained identifier is a compatibility name for this noninjectivity witness. -/
theorem DP_projection_is_not_substitution_invariant :
    ∃ (a b : RecursorTerm), a ≠ b ∧
      dpCollapseToVoid a = dpCollapseToVoid b := by
  refine ⟨RecursorTerm.recR RecursorTerm.void RecursorTerm.void
            RecursorTerm.void,
          RecursorTerm.recR RecursorTerm.void RecursorTerm.void
            (RecursorTerm.delta RecursorTerm.void),
          ?_, rfl⟩
  intro h; cases h

/-- Compatibility record containing static scope text and the two-term
constant-collapse witness. Its proposition field is the displayed noninjectivity
witness. -/
structure PartialProgressClaim where
  obstruction :
    String :=
      "Compatibility scope: the local proposition is constant-map "
      ++ "noninjectivity on two closed terms. The theorem-backed "
      ++ "free-algebra result is provided by "
      ++ "DPConfessionLicenseUnconditional."
  closure_path :
    String :=
      "Static dependency: use the unconditional free-algebra declaration "
      ++ "for signature expressibility; use PayloadGrowthBlindness for "
      ++ "the imported mass-growth comparison."
  negative_witness_present : ∃ (a b : RecursorTerm), a ≠ b
                                ∧ dpCollapseToVoid a = dpCollapseToVoid b :=
    DP_projection_is_not_substitution_invariant
  commercial_claim_status : String := "compatibility"

/-- Default diagnostic record. The theorem-backed declaration with the related public name
is `DPConfessionLicenseUnconditional.dp_projection_not_in_recursor_signature_unconditional`. -/
def dp_projection_not_in_recursor_signature : PartialProgressClaim := {}

/-- Under the three displayed normalization equations, the recursor and
circular-reference orbit measures satisfy the imported
`MassIndistinguishable` predicate. The retained identifier is a compatibility
name for this measure equality. -/
theorem arts_giesl_soundness_requires_external_observer
    (b s A B : Trace) (D : DirectMeasureProofSystem)
    (mu_delta : ∀ t : Trace, D.mu (delta t) = D.mu t + 1)
    (mu_rec : ∀ b' s' u : Trace, D.mu (recΔ b' s' u) = D.mu u + 1)
    (mu_merge : ∀ x y : Trace, D.mu (merge x y) = D.mu x + D.mu y + 1) :
    MassIndistinguishable
      (fun n => D.mu (RecursorOrbit b s n))
      (fun n => D.mu (CircularReferenceOrbit A B n)) :=
  operational_inexpressibility_at_step_duplicator b s A B D
    mu_delta mu_rec mu_merge

/-- Alias of the static compatibility record. Its type is
`PartialProgressClaim`. -/
def recursor_termination_provable_iff_external_DP_license_accepted
    : PartialProgressClaim :=
  dp_projection_not_in_recursor_signature

end OperatorKO7.Meta.Recursor.DPConfessionLicense
