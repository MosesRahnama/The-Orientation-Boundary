-- Non-overclaim survives in its live form: at least one row is not closed by a
-- Lean theorem of this development, and not every row is.
example : ResidualMethodClosureNotUniversallyClosed :=
  residualMethodClosureCatalog_not_universally_closed

-- The exact status of the certified-engine row.
example :
    residualMethodClosureCatalogRowStatus
        ResidualMethodClosureCatalogRow.semanticCertifiedExternalEngine =
      ResidualMethodClosureStatus.certifiedSuccess := rfl

-- The same row projected through the final catalog gives terminality, which is
-- what the catalog surface actually carries.
example {Sys : OperatorKO7.StepDuplicating.StepDuplicatingSchema.StepDuplicatingSystem} :
    residualMethodClosureCatalogRowStatus
        ResidualMethodClosureCatalogRow.semanticCertifiedExternalEngine = .blocked ∨
      residualMethodClosureCatalogRowStatus
          ResidualMethodClosureCatalogRow.semanticCertifiedExternalEngine =
            .closedByLeanTheorem ∨
        residualMethodClosureCatalogRowStatus
            ResidualMethodClosureCatalogRow.semanticCertifiedExternalEngine =
              .reducedToExistingTheorem ∨
          residualMethodClosureCatalogRowStatus
              ResidualMethodClosureCatalogRow.semanticCertifiedExternalEngine =
                .licensedEscape ∨
            residualMethodClosureCatalogRowStatus
                ResidualMethodClosureCatalogRow.semanticCertifiedExternalEngine =
                  .certifiedSuccess :=
  residualMethodClosureCatalog_projects_terminal_status
    (tool_search_fragment_final_projects_residual_method_closure_catalog
      (Sys := Sys) (tool_search_fragment_final_catalog (Sys := Sys))) _

