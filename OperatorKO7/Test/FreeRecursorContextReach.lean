local notation "CtxStep" => OperatorKO7.Meta.OperationalInexpressibility.FreeRecursorContext.Step
local notation "ctxNormalize" => OperatorKO7.Meta.OperationalInexpressibility.FreeRecursorContext.normalize

example : ctxNormalize (.recR .void .void (.delta (.delta .void))) =
    .app .void (.app .void .void) := rfl

example : CtxStep (.app .void (.recR .void .void .void)) (.app .void .void) :=
  contextual_step_not_root_step.1

example : Relation.ReflTransGen CtxStep
    (.app (.recR .void .void .void)
      (.recR .void (.recR .void .void .void) .void))
    (.app .void .void) :=
  normalize_reachable _

example : Relation.ReflTransGen CtxStep
    (.recR .void .void (.delta .void)) (.app .void .void) :=
  normalize_reachable _

example : ∃ d,
    Relation.ReflTransGen CtxStep
      (.app (.recR .void .void .void)
        (.recR .void (.recR .void .void .void) .void)) d ∧
    Relation.ReflTransGen CtxStep (.recR .void .void (.delta .void)) d :=
  freeRecursor_ctx_confluent
    (.single (root_step (.succ .void (.recR .void .void .void) .void)))
    (.single (OperatorKO7.Meta.OperationalInexpressibility.FreeRecursorContext.Step.inContext
      (.recPayload .void .hole (.delta .void))
      (.zero .void .void)))

example (t : RecursorTerm) : Relation.ReflTransGen CtxStep t (ctxNormalize t) ∧
    (∀ u, ¬ CtxStep (ctxNormalize t) u) :=
  freeRecursor_ctx_normalization_certificate t

example : OperatorKO7.Meta.OperationalInexpressibility.FreeRecursorContext.joinable?
    (.recR .void .void (.delta .void)) (.app .void .void) = true := by decide

example : OperatorKO7.Meta.OperationalInexpressibility.FreeRecursorContext.joinable?
    .void (.delta .void) = false := by decide

