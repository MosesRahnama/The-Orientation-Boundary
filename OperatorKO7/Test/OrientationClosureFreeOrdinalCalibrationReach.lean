namespace OrientationClosureFreeOrdinalCalibrationReach

open OperatorKO7.Methods.OrientationClosure.SchemaCore
open OperatorKO7.Methods.OrientationClosure.FreeOrdinalCalibration
open scoped Ordinal

/-! The natural-number statements of the module before the generalization are instances of the
general statements. -/

example : (∀ t : FreeTerm Nat, ctxHeight t < ω) ∧ ∀ n : Nat, ∃ t : FreeTerm Nat, (n : Ordinal) ≤ ctxHeight t :=
  ctx_calibrated_omega

example : ⨆ t : FreeTerm Nat, ctxHeight t = ω :=
  iSup_ctxHeight

example : (∀ t : FreeTerm Nat, callHeight t < ω) ∧ ∀ n : Nat, ∃ t : FreeTerm Nat, (n : Ordinal) ≤ callHeight t :=
  call_calibrated_omega

/-! Node C14 at natural-number variables, literally: every finite height is attained. -/

example : ∀ n : Nat, ∃ t : FreeTerm Nat, ctxHeight t = n :=
  ctxHeight_attains

example : ∀ n : Nat, ∃ t : FreeTerm Nat, callHeight t = n :=
  callHeight_attains

/-! Non-vacuity at other variable types: closed terms and a variable type in universe one. -/

example : ∀ n : Nat, ∃ t : FreeTerm Empty, ctxHeight t = n :=
  ctxHeight_attains

example : ∀ n : Nat, ∃ t : FreeTerm (ULift.{1} Bool), callHeight t = n :=
  callHeight_attains

example : ⨆ t : FreeTerm (ULift.{1} Bool), ctxHeight t = ω :=
  iSup_ctxHeight

example : (3 : Ordinal) ∈ Set.range (ctxHeight (ν := Bool)) := by
  rw [range_ctxHeight_eq_range_natCast]
  exact ⟨3, by norm_num⟩

end OrientationClosureFreeOrdinalCalibrationReach
