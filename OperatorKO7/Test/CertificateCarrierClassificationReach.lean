open OperatorKO7.Meta.Rewriting OperatorKO7.Meta.UniqueNormalization OperatorKO7.Meta.UniqueNormalization.CertificateCapacity

/-! Controls: the one-element total rule model fails the certificate, `Nat` succeeds, finite
carriers are refuted by both arguments, and default-arity branches take the base value. -/

example : HasCertificate capacity_rules Nat := capacity_countable_certificate

example : unitInterp.RulesHold capacity_rules ∧
    ¬ ModelRefutesOverlaps (linHub capacity_rules) unitInterp :=
  ⟨unit_rulesHold, unit_not_certificate⟩

example : ¬ HasCertificate capacity_rules (Fin 3) := capacity_no_finite_certificate

example : ¬ HasCertificate capacity_rules Bool := capacity_no_finite_certificate_direct

example : HasCertificate capacity_rules Nat ↔ Infinite Nat := capacity_certificate_iff_infinite Nat

example : SplitRay.natRay.interp.op 7 [2, 2] = 0 := SplitRay.natRay.interp_H_eq 2

example : SplitRay.natRay.interp.op 7 [0, 1] = 1 := SplitRay.natRay.interp_H_ne (by decide)

example : SplitRay.natRay.interp.op 5 [] = 0 ∧ SplitRay.natRay.interp.op 7 [4] = 0 :=
  ⟨SplitRay.natRay.interp_default_S_nil, SplitRay.natRay.interp_default_H_one 4⟩
